# Kopieer dit bestand naar .env en vul de waarden in.
# Echte wachtwoorden of tokens horen alleen in .env (staat in .gitignore),
# nooit in dit voorbeeldbestand of in de broncode.

# Basis-URL van de Fake Store API (producten en categorieën)
VITE_FAKESTORE_API_URL=https://fakestoreapi.com

# NOVI Dynamic API (registreren, inloggen en favorieten)
VITE_NOVI_API_URL=https://novi-backend-api-wgsgz.ondigitalocean.app
# Jouw persoonlijke project-ID uit de activatiemail van de NOVI Dynamic API
VITE_NOVI_PROJECT_ID=
